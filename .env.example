# Salin ke .env lalu isi. Jangan commit .env.

# Lokal: docker compose up -d (lihat docker-compose.yml).
# Produksi (Vercel): diisi otomatis oleh integrasi Neon; jangan diisi manual.
DATABASE_URL="postgresql://sipesek:sipesek@localhost:5432/sipesek?schema=public"

# Rahasia untuk menandatangani cookie sesi admin (minimal 32 karakter acak)
JWT_SECRET=""

# Login orang tua dengan Google (Google Cloud Console > Google Auth Platform > Clients).
# Client ID tidak rahasia. GOOGLE_CLIENT_ID dipakai API untuk memeriksa token; yang NEXT_PUBLIC_
# dipakai tombol di halaman (isi di Vercel dan di .env pengembang halaman). Nilainya sama.
GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Rahasia untuk sidik NISN (minimal 32 karakter acak, mis. `openssl rand -base64 48`).
# JANGAN diganti setelah ada data anak: pengecekan NISN ganda akan rusak.
NISN_PEPPER=""

# Batas cek tamu (belum masuk) per jam per IP. 0 = tanpa batas. Orang tua yang sudah masuk tidak dibatasi per IP.
BATAS_TAMU_PER_JAM=10

# Akun admin pertama yang dibuat oleh `npm run db:seed`
ADMIN_EMAIL="admin@sipesek.local"
ADMIN_PASSWORD=""

# Folder berisi CSV klasemen SPMB mentah (di luar repo atau di data-mentah/)
DATA_MENTAH_DIR="./data-mentah"

# Hanya untuk topologi lama (halaman di Vercel, API di homeserver). KOSONGKAN di Vercel:
# halaman dan API kini sama-sama berjalan di Vercel dengan database Neon. Bila diisi,
# semua /api/* diteruskan ke alamat ini dan aplikasi tidak memakai Neon.
BACKEND_URL=""
